# Claude API for chat
CLAUDE_API_KEY=sk-ant-...
CLAUDE_API_BASE=https://api.anthropic.com
CLAUDE_MODEL=claude-sonnet-4-20250514

# Emergency migration bridge for an already-open pre-stage-3 browser tab.
# Leave unset normally; when set to 1 the server accepts that old tab's inline
# credential format for the request, but never returns or syncs the key.
# LUMBRE_MODEL_GATEWAY_LEGACY_INGEST=1

# Diary backend (starfire-diary)
DIARY_API_BASE=https://starfire-diary.zeabur.app

# Memory backend (ombre brain)
BRAIN_API_BASE=https://xiaohuo.zeabur.app

# Gmail tools (OAuth2)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_ADDRESS=gris.sidereal@gmail.com

# Required: public access authentication (minimum 12 characters)
LUMBRE_ACCESS_PASSWORD=replace-with-a-long-random-password
# Optional: separate cookie-signing secret; changing it logs out all devices
LUMBRE_AUTH_SECRET=replace-with-another-long-random-secret

# Optional: dedicated secret for server-internal auto-wake -> /api/chat calls.
# Falls back to LUMBRE_AUTH_SECRET when omitted.
LUMBRE_INTERNAL_SECRET=
