FROM node:22-bookworm-slim@sha256:83f487e0a63425e5b4d146fb5e5be574bcbe1b7b843d3ebafdd95eaf7767a7e5

RUN apt-get update \
  && apt-get install -y --no-install-recommends bubblewrap socat git ca-certificates \
  && rm -rf /var/lib/apt/lists/* \
  && npm install --global "@anthropic-ai/claude-code@2.1.321" \
  && claude --version | grep -F "2.1.321"

RUN useradd --create-home --uid 10001 ccgateway \
  && mkdir -p /gateway-data /gateway-workspace /workspaces/lumbre /etc/claude-code /opt/lumbre/services/cc-probe /opt/lumbre/services/cc-gateway \
  && chown -R ccgateway:ccgateway /gateway-data /gateway-workspace /workspaces/lumbre

COPY cc-probe/managed-settings.json /etc/claude-code/managed-settings.json
COPY cc-probe/contract.mjs /opt/lumbre/services/cc-probe/contract.mjs
COPY cc-gateway/*.mjs /opt/lumbre/services/cc-gateway/

ENV DISABLE_AUTOUPDATER=1 \
    DISABLE_UPDATES=1 \
    CC_GATEWAY_ISOLATED=1 \
    CC_GATEWAY_DATA_DIR=/gateway-data \
    CC_GATEWAY_CLAUDE_HOME=/gateway-data/claude-home \
    CC_GATEWAY_REHYDRATE_TURNS=16 \
    CC_GATEWAY_WORKSPACE=/gateway-workspace \
    CC_GATEWAY_CODE_WORKSPACE=/workspaces/lumbre \
    CLAUDE_CODE_SUBPROCESS_ENV_SCRUB=1 \
    PORT=8787

USER ccgateway
WORKDIR /gateway-workspace
VOLUME ["/gateway-data", "/workspaces/lumbre"]
EXPOSE 8787

ENTRYPOINT ["node", "/opt/lumbre/services/cc-gateway/server.mjs"]
